# Copy to .env and adjust if needed (optional — defaults work for local demos)

# DATABASE_URL=sqlite:///./freight_challenge.db

# Wall-clock seconds between new live orders (~5 orders in 5 minutes at 60)
ORDER_INTERVAL_SECONDS=60

# How long an open order stays bookable (minutes of sim time)
ORDER_TTL_SIM_MINUTES=10

# 1 = real time (default). Raise for faster demos, e.g. 60 ≈ 1 sim hour / real minute
SIMULATION_SPEED=1

BID_WIN_PROBABILITY=0.45
BID_DECISION_SIM_MINUTES=3
UNITS_PER_TERMINAL=8
HISTORY_ROWS=2500

# Accept/bid rejected when order weight exceeds this
MAX_WEIGHT_LBS=44000
